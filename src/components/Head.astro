---
import fontUrl from "@fontsource/questrial/files/questrial-latin-400-normal.woff2?url";
import { SITE } from "../config";
import { communityJsonLd, jsonLdString } from "../lib/schema";

export interface Props {
  /** Full page title from the site's SEO configuration. */
  title?: string;
  description?: string;
  /** Path or absolute URL of a 1200×630 image. */
  image?: string;
  noindex?: boolean;
  /** Open Graph type: "article" for blog posts. */
  type?: "website" | "article";
  /** Article dates and tags (used when type is "article"). */
  published?: Date;
  modified?: Date;
  tags?: string[];
  /** Extra structured data (e.g. BlogPosting) emitted next to the Organization data. */
  jsonLd?: object;
}

const {
  title = SITE.seo.home.title,
  description = SITE.description,
  image = "/og.png",
  noindex = false,
  type = "website",
  published,
  modified,
  tags = [],
  jsonLd,
} = Astro.props;
const site = Astro.site ?? new URL(SITE.url);
const fullTitle = title;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#05052E" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/rss.xml" />
<link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />

<meta property="og:type" content={type} />
{type === "article" && published && <meta property="article:published_time" content={published.toISOString()} />}
{type === "article" && modified && <meta property="article:modified_time" content={modified.toISOString()} />}
{type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={jsonLdString(communityJsonLd(site))} />
{jsonLd && <script type="application/ld+json" set:html={jsonLdString(jsonLd)} />}
