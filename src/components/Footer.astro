---
/** 13. Footer over an animated 3D field of dots (canvas, src/scripts/scenes.ts). */
import { SITE } from "../config";

const hasConnectLinks = Boolean(
  SITE.links.linkedinCommunity || SITE.links.communityGroup || SITE.links.contactEmail || SITE.links.eventRegistration,
);
---

<footer class="site-footer">
  <canvas class="footer-wave" data-scene="wave" aria-hidden="true"></canvas>
  <span class="footer-rule" aria-hidden="true"></span>
  <div class="container-x footer-grid">
    <div class="f-touch">
      <p class="text-2xl font-semibold">{SITE.displayLogo}</p>
      <p class="mt-3 max-w-md text-muted">{SITE.tagline}</p>
      {SITE.links.join && <a href={SITE.links.join} class="btn btn-primary f-btn">{SITE.primaryCtaLabel}</a>}
    </div>

    <nav aria-labelledby="footer-explore" class="f-col f-links">
      <h2 id="footer-explore" class="f-head">Explore</h2>
      <ul class="f-list">
        {
          SITE.nav.map((item) => (
            <li>
              <a href={item.href} class="f-link">{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      hasConnectLinks && (
        <div class="f-col">
          <h2 class="f-head">Connect</h2>
          <ul class="f-list">
            {SITE.links.linkedinCommunity && <li><a href={SITE.links.linkedinCommunity} class="f-link" target="_blank" rel="noopener">LinkedIn</a></li>}
            {SITE.links.communityGroup && <li><a href={SITE.links.communityGroup} class="f-link" target="_blank" rel="noopener">Community Group</a></li>}
            {SITE.links.contactEmail && <li><a href={`mailto:${SITE.links.contactEmail}`} class="f-link">Email</a></li>}
            {SITE.links.eventRegistration && <li><a href={SITE.links.eventRegistration} class="f-link" target="_blank" rel="noopener">Upcoming Events</a></li>}
          </ul>
        </div>
      )
    }

    <div class="f-legal">
      <p>
        &copy; {SITE.copyrightYear} {SITE.name}.
        <a href="/privacy/" class="f-link ml-3 underline">Privacy</a>
        <a href="/rss.xml" class="f-link ml-3 underline">RSS</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .footer-wave {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    color: #8582e0;
  }
  .footer-rule {
    position: absolute;
    top: 0;
    left: 5%;
    right: 0;
    height: 1px;
    background: var(--c-line);
  }
  .footer-grid {
    position: relative;
    display: grid;
    grid-template-columns: 180px 1fr;
    padding-block: 49px 53px;
    font-size: 16px;
    line-height: 1.6;
  }
  .f-touch {
    grid-column: 1 / -1;
  }
  .f-btn {
    margin-top: 26px;
  }
  .f-col {
    margin-top: 24px;
  }
  .f-head {
    font-size: 16px;
    line-height: 1.6;
    color: var(--c-muted);
  }
  .f-list {
    display: grid;
    gap: 12px;
    margin-top: 23px;
  }
  .f-link {
    color: var(--c-white);
    border-radius: 0.375rem;
    transition: color 0.2s;
  }
  .f-link:hover {
    color: var(--accent);
  }
  .f-legal {
    grid-column: 1 / -1;
    order: 2;
    margin-top: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--c-ink);
  }
  @media (min-width: 1001px) {
    .footer-rule {
      left: max(16px, (100% - 1296px) / 2);
    }
    .footer-grid {
      grid-template-columns: 63.42% 25.58% 1fr;
      padding-block: 97px 100px;
    }
    .f-touch {
      grid-column: auto;
    }
    .f-col {
      margin-top: 0;
    }
    .f-legal {
      grid-column: 1 / 3;
      order: 0;
      margin-top: 47px;
    }
  }
</style>
