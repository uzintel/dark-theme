---
/** Community introduction and quote-ready intro section. */
import FillLines from "../FillLines.astro";
import Orbits from "../Orbits.astro";
---

<section class="statement" aria-labelledby="statement-title">
  <div class="container-x statement-col">
    <FillLines
      id="statement-title"
      as="h2"
      class="h-statement statement-text"
      lines={["Learn. *Connect.*", "*Grow*."]}
    />
    <Orbits class="statement-orbits" follow={100} />
    <p class="t-big statement-para">
      Project management is more than frameworks and methodologies. It's about people, collaboration, decision-making, and
      delivering meaningful outcomes. TPMC creates a space where professionals can exchange experiences, discuss real-world
      challenges, and learn from one another. Whether you're an experienced project manager or just beginning your journey,
      there's a place for you in our community.
    </p>
  </div>
</section>

<style>
  /* Phones and tablets: one column in the page flow (the offsets reproduce the reference at 375px). */
  .statement {
    position: relative;
    z-index: 1;
    padding-block: 48px 48.7px;
    background: var(--c-bg);
  }
  .statement-col {
    position: relative;
    height: 100%;
  }
  .statement-col :global(.statement-text .fl + .fl) {
    margin-top: 0.037em;
  }
  .statement-para {
    margin-top: 47.3px;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.3;
  }
  .statement :global(.statement-orbits) {
    display: none;
  }
  /* Desktop (the reference at 1440 × 727): a 1089px block; orbits left, paragraph in the right half. */
  @media (min-width: 1001px) {
    .statement {
      height: 1089px;
      padding-block: 0;
    }
    .statement-col :global(.statement-text) {
      position: absolute;
      top: 288px;
      left: 0;
      right: 0;
    }
    .statement-col :global(.statement-text .fl + .fl) {
      margin-top: 0;
    }
    .statement :global(.statement-orbits) {
      display: block;
      position: absolute;
      top: 534px;
      left: -90px;
      width: 480px;
      height: 471px;
    }
    .statement-para {
      position: absolute;
      top: 630px;
      left: 50%;
      right: 0;
      margin: 0;
    }
  }
</style>
