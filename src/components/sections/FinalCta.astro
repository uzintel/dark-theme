---
/** Final call to action to connect with TPMC. */
import FillLines from "../FillLines.astro";
import { SITE } from "../../config";
---

<section class="final-cta" aria-labelledby="cta-title">
  <div class="container-x cta-col">
    <FillLines
      as="h2"
      id="cta-title"
      class="cta-title"
      lines={["Better Projects Start With", "Better *Connections*."]}
      ranges={[
        [20, 50],
        [30, 60],
      ]}
    />
    <p class="cta-copy">Join a community of professionals who believe in learning together, sharing openly, and helping each other succeed.</p>
    <div class="cta-actions">
      {SITE.links.join && <a href={SITE.links.join} class="btn btn-primary cta-btn">{SITE.primaryCtaLabel}</a>}
      <a href="/contact/" class="btn btn-secondary cta-btn">Get in Touch</a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding-block: 191px;
  }
  .cta-col :global(.cta-title) {
    font-size: min(7.739547vw, 52px);
    line-height: 1.3;
  }
  .cta-copy {
    max-width: 680px;
    margin-top: 1.25rem;
    color: var(--c-muted);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (min-width: 751px) {
    .final-cta {
      display: grid;
      align-content: center;
      padding-block: 96px;
    }
    .cta-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>
