---
import { SITE } from "../../config";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-net" aria-hidden="true">
    <canvas class="net-in" data-scene="plexus"></canvas>
  </div>
  <div class="hero-col">
    <p class="hero-eyebrow">{SITE.name}</p>
    <h1 id="hero-title" class="h-display hero-title">
      <span class="h1-line tilt-in">Where Project</span>
      {" "}
      <span class="h1-line wipe-in">Minds Connect<span class="hl">.</span></span>
    </h1>
    <p class="hero-copy">
      A community for project managers, product professionals, and aspiring leaders to connect, exchange knowledge, and grow
      together. Through interactive discussions, practical learning, and networking opportunities, TPMC brings together
      professionals from different industries and backgrounds.
    </p>
    <div class="hero-actions">
      {SITE.links.join && <a href={SITE.links.join} class="btn btn-primary btn-lg">Join the Community</a>}
      <a href="/activities/" class="btn btn-secondary btn-lg">Explore Our Activities</a>
    </div>
    <ul class="highlights" aria-label="Community highlights">
      <li>Tokyo-Based Community</li>
      <li>Cross-Industry Network</li>
      <li>Practical Knowledge Sharing</li>
      <li>Open to All Experience Levels</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: clip;
  }
  .hero-net {
    position: absolute;
    inset: 0;
    -webkit-mask-image:
      linear-gradient(90deg, rgb(0 0 0 / 0.18) 0%, rgb(0 0 0 / 0.18) 22%, #000 58%),
      linear-gradient(180deg, #000 72%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, rgb(0 0 0 / 0.18) 0%, rgb(0 0 0 / 0.18) 22%, #000 58%),
      linear-gradient(180deg, #000 72%, transparent 100%);
    mask-composite: intersect;
  }
  .hero-net canvas {
    display: block;
    width: 100%;
    height: 100%;
    color: #ffffff;
  }
  .hero-col {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 1.25rem;
    width: 90%;
    min-height: 100svh;
    margin-inline: auto;
    padding-block: calc(var(--header-h) + 32px) 48px;
  }
  .hero-eyebrow {
    color: var(--c-muted);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero-title {
    color: var(--c-white);
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 1.02;
  }
  .h1-line {
    display: block;
  }
  .hero-copy {
    max-width: 760px;
    font-size: clamp(1.05rem, 2vw, 1.375rem);
    line-height: 1.5;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1rem;
    width: min(100%, 780px);
    margin-top: 0.5rem;
    color: var(--c-muted);
    font-size: 0.9375rem;
  }
  .highlights li {
    border-left: 2px solid var(--accent);
    padding-left: 0.75rem;
  }
  @media (min-width: 751px) {
    .hero-col {
      width: min(1200px, 100% - 64px);
      gap: 1.5rem;
    }
    .highlights {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 1rem;
    }
  }
</style>
