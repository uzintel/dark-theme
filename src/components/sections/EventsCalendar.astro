---
import { SITE } from "../../config";
---

{SITE.links.eventCalendarEmbed && (
  <section class="section" aria-labelledby="events-title">
    <div class="container-x">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-5">
        <div>
          <h2 id="events-title" class="h-section">Upcoming Events</h2>
          <p class="mt-4 max-w-3xl text-muted">
            Event dates, times, locations, and format are listed on Luma. Check each listing for confirmed details.
          </p>
        </div>
        {SITE.links.eventRegistration && (
          <a href={SITE.links.eventRegistration} class="btn btn-secondary" target="_blank" rel="noopener noreferrer">
            View Upcoming Events
          </a>
        )}
      </div>
      <div class="calendar-frame">
        <iframe
          src={SITE.links.eventCalendarEmbed}
          title="TPMC upcoming events calendar"
          width="600"
          height="450"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
      {SITE.links.eventRegistration && (
        <p class="mt-4 text-sm text-muted">
          If the calendar doesn't load,{" "}
          <a href={SITE.links.eventRegistration} target="_blank" rel="noopener noreferrer" class="underline">view events on Luma</a>.
        </p>
      )}
    </div>
  </section>
)}

<style>
  .calendar-frame {
    width: 100%;
    max-width: 600px;
    margin-inline: auto;
    overflow: clip;
    border: 1px solid var(--c-line);
    border-radius: 4px;
  }
  .calendar-frame iframe {
    display: block;
    width: 100%;
    height: 450px;
    border: 0;
  }
</style>
