---
/** Four steps from joining the community to growing a professional network. */
import Orbits from "../Orbits.astro";

const steps = [
  {
    title: "Join the Community",
    body: "Become part of a network of professionals passionate about project management and continuous learning.",
  },
  {
    title: "Participate in Discussions",
    body: "Join our regular sessions to exchange ideas, share experiences, and explore practical challenges.",
  },
  {
    title: "Learn and Contribute",
    body: "Gain insights from others while contributing your own knowledge, perspectives, and expertise.",
  },
  {
    title: "Grow Your Network",
    body: "Build lasting professional relationships and discover opportunities for collaboration and career growth.",
  },
];
---

<section class="process" aria-labelledby="process-title">
  <div class="process-panel">
    <h2 id="process-title" class="process-heading">Your Community Journey</h2>
    <ol class="steps">
      {
        steps.map((step) => (
          <li class="step">
            <span class="step-dot" data-enter="dot" aria-hidden="true" />
            <h3 class="step-title" data-enter="tilt">
              {step.title}
            </h3>
            <p class="step-body" data-enter="rise">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
  <div class="process-side" aria-hidden="true">
    <div class="process-orbits" data-follow="500">
      <Orbits variant="rings" class="process-rings" />
    </div>
  </div>
</section>

<style>
  .process {
    position: relative;
    display: flex;
    overflow-x: clip;
  }
  .process-panel {
    flex: none;
    width: 65%;
    padding: 48px 24px;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--accent);
    color: var(--accent-text);
  }
  .steps {
    display: grid;
    gap: 24px;
  }
  .process-heading {
    margin-bottom: 2rem;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 1.15;
  }
  .step-dot {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: currentColor;
  }
  .step-title {
    margin-top: 12px;
    font-size: 5.5vw;
    font-weight: 700;
    line-height: 1.3;
  }
  .step-body {
    margin-top: 12px;
    font-size: 18px;
    line-height: 1.6;
  }
  .process-side {
    flex: 1;
    min-width: 0;
  }
  .process-orbits {
    position: sticky;
    top: 144px;
    margin-top: 98px;
    height: 133px;
  }
  .process-orbits :global(.process-rings) {
    width: 100%;
    height: 100%;
  }
  @media (min-width: 751px) {
    .process-panel {
      padding: 50vh 0 144px;
    }
    .steps {
      width: 450px;
      max-width: calc(100% - 48px);
      margin-inline: auto;
      gap: 96px;
    }
    .process-heading {
      width: 450px;
      max-width: calc(100% - 48px);
      margin-inline: auto;
    }
    .step-dot {
      width: 24px;
      height: 24px;
    }
    .step-title {
      margin-top: 24px;
      font-size: 34px;
    }
    .step-body {
      margin-top: 24.6px;
      font-size: 24px;
    }
    .process-orbits {
      top: 20vh;
      margin-block: 20vh;
      height: 60vh;
    }
  }
</style>
