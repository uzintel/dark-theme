---
import FillLines from "../FillLines.astro";

const activities = [
  {
    title: "Knowledge Sharing",
    description: "Exchange practical insights, methodologies, and lessons learned from real projects.",
    href: "/activities/#knowledge-sharing",
  },
  {
    title: "Community Meetups",
    description: "Connect with fellow professionals through interactive discussions and networking sessions.",
    href: "/activities/#community-meetups",
  },
  {
    title: "Career Development",
    description: "Explore career paths, professional certifications, and leadership opportunities.",
    href: "/activities/#career-development",
  },
  {
    title: "Industry Insights",
    description: "Discuss emerging technologies, AI, Agile, and evolving project management practices.",
    href: "/activities/#industry-insights",
  },
  {
    title: "Collaborative Learning",
    description: "Learn from peers through case studies, workshops, and problem-solving discussions.",
    href: "/activities/#collaborative-learning",
  },
  {
    title: "Professional Networking",
    description: "Build meaningful relationships with professionals across industries and organizations.",
    href: "/activities/#professional-networking",
  },
];
---

<section class="activities-preview overflow-x-clip" aria-labelledby="activities-preview-title">
  <div class="container-x">
    <FillLines as="h2" id="activities-preview-title" class="h-section" lines={["What We *Do*"]} ranges={[[25, 70]]} />
    <ul class="activity-grid mt-10">
      {
        activities.map((activity, index) => (
          <li>
            <a href={activity.href} class="activity-card card p-7" data-enter="flip" style={`--i:${index}`}>
              <span class="text-sm text-accent">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="mt-5 text-2xl">{activity.title}</h3>
              <p class="mt-3 text-muted">{activity.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .activities-preview {
    padding-block: 48px;
  }
  .activity-grid {
    display: grid;
    gap: 1rem;
  }
  .activity-card {
    display: block;
    height: 100%;
  }
  .activity-card:hover {
    border-color: var(--accent);
  }
  @media (min-width: 640px) {
    .activity-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1001px) {
    .activities-preview {
      padding-block: 144px;
    }
    .activity-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
      margin-top: 3rem;
    }
  }
</style>
