---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { SITE } from "../../config";
import { getPosts, postPath, formatDate } from "../../lib/blog";

const posts = await getPosts();
const site = Astro.site ?? new URL(SITE.url);

const listJsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: `${SITE.name} blog`,
  url: new URL("/blog/", site).href,
  inLanguage: SITE.lang,
  publisher: { "@id": new URL("/#organization", site).href },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    url: new URL(postPath(post), site).href,
    datePublished: post.data.pubDate.toISOString(),
  })),
};
---

<BaseLayout title={SITE.seo.blog.title} description={SITE.seo.blog.description} jsonLd={listJsonLd}>
  <div class="blog-page-header">
    <PageHeader
      title="The TPMC *Blog*."
      lead="Event recaps, practical project management guides, and news from Tokyo's project management community."
    />
  </div>

  <section class="section pt-12 sm:pt-16" aria-labelledby="posts-title">
    <div class="container-x">
      <h2 id="posts-title" class="sr-only">All posts</h2>
      {
        posts.length === 0 ? (
          <p class="text-muted">No posts yet. Check back soon.</p>
        ) : (
          <ul class="grid gap-5 md:grid-cols-2">
            {posts.map((post, index) => (
              <li class="card post-card" style={`--i:${index}`}>
                <a href={postPath(post)} class="block h-full p-7 sm:p-8" lang={post.data.lang}>
                  <p class="text-sm text-muted">
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, post.data.lang)}</time>
                  </p>
                  <h3 class="mt-4 text-2xl leading-snug text-white">{post.data.title}</h3>
                  <p class="mt-3 text-muted">{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <p class="mt-5 text-sm text-accent">{post.data.tags.map((tag) => `#${tag.replaceAll(" ", "")}`).join("  ")}</p>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .blog-page-header :global(.hl) {
    color: var(--c-white);
  }

  .post-card {
    transition: border-color 0.2s;
  }
  .post-card:hover,
  .post-card:focus-within {
    border-color: rgb(255 255 255 / 0.5);
  }
</style>
