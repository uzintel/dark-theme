---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { SITE } from "../../config";

const activities = [
  {
    id: "knowledge-sharing",
    title: "Knowledge Sharing Sessions",
    subtitle: "Learn from real experiences.",
    description:
      "Project management challenges rarely have one perfect solution. Our knowledge-sharing sessions provide opportunities to exchange perspectives, discuss practical approaches, and learn from experiences across different organizations.",
    listTitle: "Topics We Explore",
    topics: [
      "Project planning and execution",
      "Stakeholder management and communication",
      "Risk management and decision-making",
      "Agile, Scrum, and hybrid methodologies",
      "Lessons learned from successful and challenging projects",
    ],
    gain: "Practical insights, fresh perspectives, and approaches you can apply to your own projects.",
  },
  {
    id: "community-meetups",
    title: "Community Meetups",
    subtitle: "Connect beyond your workplace.",
    description:
      "TPMC brings together professionals from different companies, industries, and backgrounds to build meaningful relationships through open conversations and shared interests.",
    listTitle: "What to Expect",
    topics: [
      "Interactive group discussions",
      "Professional networking",
      "Peer-to-peer knowledge exchange",
      "Opportunities to share challenges and ideas",
      "Connections with Tokyo's international professional community",
    ],
    gain: "A broader professional network and meaningful connections with people who share your interests.",
  },
  {
    id: "career-development",
    title: "Career & Professional Development",
    subtitle: "Take the next step in your career.",
    description:
      "Whether you're entering project management, transitioning into leadership, or expanding your expertise, TPMC provides an environment for exchanging career experiences and learning from peers.",
    listTitle: "Topics We Explore",
    topics: [
      "Project management career paths",
      "PMP, PSM, and other certifications",
      "Leadership and communication skills",
      "Career transitions and professional growth",
      "Working in international and Japanese organizations",
    ],
    gain: "Career insights, practical guidance, and perspectives from professionals at different stages of their careers.",
  },
  {
    id: "industry-insights",
    title: "Technology & Industry Insights",
    subtitle: "Stay curious. Stay relevant.",
    description:
      "The project management profession continues to evolve alongside new technologies, business models, and ways of working. TPMC encourages conversations about the trends shaping how projects and products are delivered.",
    listTitle: "Topics We Explore",
    topics: [
      "Artificial intelligence in project management",
      "Automation and productivity tools",
      "Digital transformation",
      "Product and project management",
      "Emerging technologies and industry trends",
    ],
    gain: "A broader understanding of evolving practices and technologies relevant to modern project delivery.",
  },
  {
    id: "collaborative-learning",
    title: "Collaborative Learning",
    subtitle: "Turn conversations into practical knowledge.",
    description:
      "Learning becomes more valuable when ideas are challenged, tested, and discussed with others. TPMC encourages interactive learning through real-world examples, collaborative problem-solving, and peer discussions.",
    listTitle: "Activities May Include",
    topics: [
      "Case study discussions",
      "Project retrospectives",
      "Group problem-solving",
      "Practical workshops",
      "Peer feedback sessions",
    ],
    gain: "New approaches to complex problems and opportunities to develop your analytical and collaborative skills.",
  },
  {
    id: "professional-networking",
    title: "Professional Networking",
    subtitle: "Build connections that matter.",
    description:
      "Professional growth often happens through conversations, shared experiences, and relationships built over time. TPMC aims to create an inclusive environment where professionals can connect regardless of their industry, organization, or experience level.",
    listTitle: "Opportunities Include",
    topics: [
      "Cross-industry networking",
      "International professional connections",
      "Peer learning and mentorship",
      "Knowledge exchange",
      "Potential collaborations",
    ],
    gain: "A supportive network of professionals who value continuous learning and mutual growth.",
  },
];
---

<BaseLayout title={SITE.seo.activities.title} description={SITE.seo.activities.description}>
  <div class="activities-heading">
    <PageHeader
      title="Learn Together. *Grow Together*."
      lead="Discover how TPMC brings professionals together through practical learning, meaningful conversations, and collaborative experiences. Our activities are designed to encourage knowledge exchange, professional development, and stronger connections within the project management community."
    />
  </div>

  <div class="container-x pb-24 lg:pb-36">
    <nav aria-label="Activities on this page" class="mt-10">
      <ul class="flex flex-wrap gap-2">
        {
          activities.map((activity) => (
            <li><a href={`#${activity.id}`} class="chip">{activity.title}</a></li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-12 divide-y divide-line border-y border-line">
      {
        activities.map((activity) => (
          <section
            id={activity.id}
            class="grid scroll-mt-28 gap-8 py-12 lg:grid-cols-12 lg:gap-12 lg:py-16"
            aria-labelledby={`${activity.id}-title`}
          >
            <div class="lg:col-span-4">
              <p class:list={["text-lg", activity.id === "knowledge-sharing" ? "knowledge-sharing-subtitle" : "text-accent"]}>
                {activity.subtitle}
              </p>
            </div>
            <div class="lg:col-span-8">
              <h2 id={`${activity.id}-title`} class="h-section">{activity.title}</h2>
              <p class="mt-5 text-lg leading-relaxed">{activity.description}</p>
              <div class="mt-8">
                <h3 class="text-lg">{activity.listTitle}</h3>
                <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                  {
                    activity.topics.map((topic) => (
                      <li class="flex gap-3 text-muted">
                        <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                        <span>{topic}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class="mt-8 rounded-2xl border border-line p-6 sm:p-8">
                <h3 class="text-lg">What You'll Gain</h3>
                <p class="mt-3 text-muted">{activity.gain}</p>
              </div>
            </div>
          </section>
        ))
      }
    </div>

    <section class="activities-cta mt-16 rounded-3xl bg-accent p-8 text-accent-text sm:p-12" aria-labelledby="activities-cta">
      <h2 id="activities-cta" class="h-section">Ready to Get Involved?</h2>
      <p class="mt-5 max-w-3xl text-lg">
        Whether you want to learn, share your expertise, or simply meet like-minded professionals, TPMC welcomes your participation.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        {SITE.links.join && <a href={SITE.links.join} class="btn btn-dark btn-lg">Join the Community</a>}
        <a href="/contact/" class="btn btn-dark btn-lg">Contact Us</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .knowledge-sharing-subtitle {
    color: var(--c-primary);
  }
  .activities-heading :global(.hl) {
    color: var(--c-white);
  }
  .activities-cta .btn-dark {
    color: var(--accent);
  }
  .chip {
    display: inline-flex;
    padding: 0.5rem 1rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    color: var(--c-muted);
    transition: color 0.2s, border-color 0.2s;
  }
  .chip:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
