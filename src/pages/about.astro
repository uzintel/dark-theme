---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SITE } from "../config";

const values = [
  {
    title: "Continuous Learning",
    text: "We believe professional development is an ongoing journey. Every experience offers an opportunity to learn and improve.",
  },
  {
    title: "Knowledge Sharing",
    text: "We encourage members to exchange practical insights, experiences, and perspectives openly.",
  },
  {
    title: "Collaboration",
    text: "We believe meaningful progress happens when people work together, support one another, and share ideas.",
  },
  {
    title: "Inclusivity",
    text: "We welcome professionals from different industries, cultures, and experience levels.",
  },
  {
    title: "Professional Growth",
    text: "We support members in developing their knowledge, confidence, leadership capabilities, and professional networks.",
  },
];

const audience = [
  "Project Managers and Program Managers",
  "Product Managers and Product Owners",
  "Scrum Masters and Agile Practitioners",
  "Business Analysts and Consultants",
  "Engineers and Technology Professionals",
  "Students and Aspiring Project Managers",
  "Professionals transitioning into project management",
];

const approach = [
  {
    title: "Learn From Each Other",
    text: "We encourage open discussions where members can exchange experiences and explore different perspectives.",
  },
  {
    title: "Focus on Practical Knowledge",
    text: "Our conversations emphasize real-world challenges, applicable insights, and lessons learned.",
  },
  {
    title: "Build Meaningful Connections",
    text: "We aim to create an environment where professional relationships grow naturally through shared interests and mutual respect.",
  },
];
---

<BaseLayout title={SITE.seo.about.title} description={SITE.seo.about.description}>
  <div class="about-page-header">
    <PageHeader
      title="A Community Built Around *Shared Growth*."
      lead="Tokyo Project Management Community (TPMC) is a professional community based in Tokyo, Japan, bringing together individuals interested in project management, product development, leadership, and professional growth. We believe that some of the most valuable professional insights come from open conversations, shared experiences, and learning from one another. TPMC provides a welcoming environment where professionals can exchange knowledge, explore challenges, and build meaningful connections beyond their organizations."
    />
  </div>

  <section class="section pt-0" aria-label="Mission and vision">
    <div class="container-x grid gap-6 md:grid-cols-2">
      <article class="card p-7 sm:p-9">
        <h2 class="h-section">Our Mission</h2>
        <p class="mt-5 text-lg text-muted">
          To connect, empower, and inspire project management professionals through knowledge sharing, collaborative learning,
          and meaningful professional relationships.
        </p>
      </article>
      <article class="card p-7 sm:p-9">
        <h2 class="h-section">Our Vision</h2>
        <p class="mt-5 text-lg text-muted">
          To become a vibrant and inclusive professional community in Tokyo where people from diverse industries and backgrounds
          learn together, exchange ideas, and contribute to better project management practices.
        </p>
      </article>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="values-title">
    <div class="container-x">
      <h2 id="values-title" class="h-section">Our Core Values</h2>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          values.map((value, index) => (
            <li class="card p-7" style={`--i:${index}`}>
              <h3 class="text-xl">{value.title}</h3>
              <p class="mt-3 text-muted">{value.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="join-title">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="join-title" class="h-section">Who Can Join?</h2>
        <p class="mt-5 text-lg text-muted">
          TPMC welcomes anyone interested in project management and related disciplines.
        </p>
        <p class="mt-6 text-lg">You don't need a specific certification, job title, or level of experience to participate.</p>
        <p class="mt-4 text-sm text-muted">
          Free to join · Membership requests are reviewed by community administrators.
        </p>
        <p class="mt-6 text-xl text-accent">What matters most is your willingness to learn, contribute, and connect.</p>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2 lg:col-span-7">
        {
          audience.map((item) => (
            <li class="card p-5 text-muted">{item}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="leadership-title">
    <div class="container-x">
      <h2 id="leadership-title" class="h-section">Community Leadership</h2>
      <p class="mt-5 max-w-4xl text-lg text-muted">
        TPMC is an independent, community-driven initiative founded by professionals who believe in the power of shared
        knowledge, collaboration, and meaningful connections.
      </p>
      <article class="card mt-8 max-w-4xl p-7 sm:p-9">
        <h3 class="text-2xl">Abdullajon Ergashov</h3>
        <p class="mt-2 text-accent"><strong>Founder &amp; Community Organizer</strong></p>
        <p class="mt-6 text-muted">
          Abdullajon is a Tokyo-based project management professional with experience leading cross-functional technology
          initiatives and working with international teams in Japan.
        </p>
        <p class="mt-4 text-muted">
          He founded TPMC to create a welcoming space where professionals from different industries and backgrounds can
          exchange practical knowledge, discuss real-world challenges, and grow together.
        </p>
        <p class="mt-4 text-muted">
          As the community develops, TPMC aims to welcome additional organizers, contributors, and community representatives
          who share its mission and values.
        </p>
      </article>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="approach-title">
    <div class="container-x">
      <h2 id="approach-title" class="h-section">Our Community Approach</h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {
          approach.map((item, index) => (
            <li class="border-t border-line pt-5" style={`--i:${index}`}>
              <h3 class="text-xl">{item.title}</h3>
              <p class="mt-3 text-muted">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="tokyo-title">
    <div class="container-x">
      <h2 id="tokyo-title" class="h-section">Based in Tokyo. Open to Diverse Perspectives.</h2>
      <p class="mt-6 max-w-4xl text-xl leading-relaxed">
        TPMC brings together professionals working across different industries and cultural backgrounds. Our community welcomes
        {SITE.community.bilingualParticipation}, helping connect local and international professionals. We believe
        diverse experiences and perspectives make our discussions more valuable.
      </p>
    </div>
  </section>

</BaseLayout>

<style>
  .about-page-header :global(.hl) {
    color: var(--c-white);
  }
</style>
