---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Statement from "../components/sections/Statement.astro";
import MediaPanel from "../components/sections/MediaPanel.astro";
import EventsCalendar from "../components/sections/EventsCalendar.astro";
import ActivityPreview from "../components/sections/ActivityPreview.astro";
import Process from "../components/sections/Process.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import { SITE } from "../config";
---

<BaseLayout title={SITE.seo.home.title} description={SITE.seo.home.description}>
  <div class="hero-wrap">
    <Hero />
    <Statement />
  </div>
  <MediaPanel />
  <ActivityPreview />
  <Process />
  <EventsCalendar />
  <FinalCta />
</BaseLayout>

<style>
  /* The hero starts under the fixed header (the page's top padding is taken back here). On wide
     screens it is sticky inside this wrapper, so the statement block slides up over it. */
  .hero-wrap {
    position: relative;
    margin-top: calc(-1 * var(--header-h));
  }
  @media (min-width: 1001px) {
    .hero-wrap :global(.hero) {
      position: sticky;
      top: 0;
    }
  }
</style>
