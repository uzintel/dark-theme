---
import BaseLayout from "../layouts/BaseLayout.astro";
import Orbits from "../components/Orbits.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <section class="container-x grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-2">
    <div>
      <p class="text-accent">Error 404</p>
      <h1 class="h-display mt-4"><span class="dim">We can't find</span> <span class="hl">this page</span></h1>
      <p class="lead mt-6 max-w-lg">The page you're looking for may have moved. Choose a page to continue.</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary btn-lg">Home <Icon name="arrow-right" class="icon-shift" /></a>
        <a href="/activities/" class="btn btn-secondary btn-lg">Activities</a>
        <a href="/contact/" class="btn btn-secondary btn-lg">Contact</a>
      </div>
    </div>
    <Orbits class="mx-auto max-w-sm" />
  </section>
</BaseLayout>
