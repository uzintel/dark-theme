---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
---

<BaseLayout title="Message Received | TPMC" description="Your message has been received by Tokyo Project Management Community." noindex>
  <section class="container-x py-20 sm:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <span class="mx-auto grid size-20 place-items-center rounded-full bg-accent text-accent-text">
        <Icon name="check" size={40} />
      </span>
      <h1 class="h-display mt-10"><span class="hl">Message Received!</span></h1>
      <p class="lead mt-6">Thank you for reaching out to TPMC. Your message has been submitted successfully. We'll get back to you as soon as possible.</p>
    </div>
    <div class="mx-auto mt-12 flex max-w-2xl flex-col justify-center gap-3 sm:flex-row">
      <a href="/contact/" class="btn btn-secondary btn-lg">Send Another Message</a>
      <a href="/" class="btn btn-primary btn-lg">Back to TPMC</a>
    </div>
  </section>
</BaseLayout>
