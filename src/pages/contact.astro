---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE } from "../config";

const next = [
  { title: "Reach Out", text: "Send us an email or reach out through one of our community channels." },
  { title: "Get Connected", text: "Our organizing team will review your inquiry and share the relevant information." },
  {
    title: "Join the Conversation",
    text: "Participate in community discussions, meet fellow professionals, and contribute to our growing network.",
  },
];
const communityGroup = SITE.links.communityGroup || SITE.links.join;
const hasOtherWays = SITE.links.linkedinCommunity || communityGroup || SITE.links.contactEmail;
---

<BaseLayout title={SITE.seo.contact.title} description={SITE.seo.contact.description}>
  <PageHeader
    title="Let's *Connect*."
    lead="Have a question, an idea, or an interest in joining TPMC? We'd love to hear from you. Whether you're interested in participating in our community, sharing your expertise, proposing a collaboration, or organizing an event together, feel free to reach out."
  />

  <section class="section pt-0" aria-labelledby="message-title">
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div id="enquiry" class="scroll-mt-28 lg:col-span-7">
        <h2 id="message-title" class="h-section">Send Us a Message</h2>
        <ContactForm id="tpmc-contact" />
      </div>

      <aside class="space-y-12 lg:col-span-5">
        {hasOtherWays && (
          <section aria-labelledby="connect-title">
            <h2 id="connect-title" class="text-2xl font-light">Other Ways to Connect</h2>
            <ul class="mt-6 space-y-8">
              {SITE.links.linkedinCommunity && (
                <li>
                  <p class="text-muted">
                    Connect with TPMC and stay informed about community activities, discussions, and upcoming opportunities.
                  </p>
                  <a href={SITE.links.linkedinCommunity} class="btn btn-secondary mt-4" target="_blank" rel="noopener">
                    Follow on LinkedIn
                  </a>
                </li>
              )}
              {communityGroup && (
                <li>
                  <p class="text-muted">
                    Join our official LinkedIn group to connect with fellow professionals and participate in discussions.
                  </p>
                  <a href={communityGroup} class="btn btn-secondary mt-4" target="_blank" rel="noopener">
                    Join the Community
                  </a>
                </li>
              )}
              {SITE.links.contactEmail && (
                <li>
                  <p class="text-muted">
                    For general inquiries, collaborations, and event proposals, please contact our organizing team.
                  </p>
                  <a href={`mailto:${SITE.links.contactEmail}`} class="btn btn-secondary mt-4">Send an Email</a>
                </li>
              )}
            </ul>
          </section>
        )}

        <section aria-labelledby="sessions-title">
          <h2 id="sessions-title" class="text-2xl font-light">Community Sessions</h2>
          <p class="mt-5 text-muted">
            See the official TPMC events calendar for upcoming sessions, dates, times, locations, and registration details.
          </p>
          <p class="mt-4 text-muted">Location: {SITE.community.location}.</p>
          <p class="mt-4 text-muted">
            Session format and location depend on each event. Check the Luma event listing for confirmed details and joining instructions.
          </p>
          {SITE.links.eventRegistration && (
            <a href={SITE.links.eventRegistration} class="btn btn-secondary mt-5" target="_blank" rel="noopener noreferrer">
              View Upcoming Events
            </a>
          )}
        </section>
      </aside>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="next-title">
    <div class="container-x">
      <h2 id="next-title" class="h-section">What Happens Next?</h2>
      <ol class="mt-10 grid gap-5 md:grid-cols-3">
        {
          next.map((step, index) => (
            <li class="card p-7" style={`--i:${index}`}>
              <span class="text-sm text-accent">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="mt-4 text-xl">{step.title}</h3>
              <p class="mt-3 text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container-x pb-24 lg:pb-36" aria-labelledby="contact-cta">
    <div class="reveal rounded-3xl bg-accent p-8 text-accent-text sm:p-12 lg:p-16">
      <h2 id="contact-cta" class="h-section">Let's Build a Stronger Community Together.</h2>
      <p class="mt-5 max-w-3xl text-lg">
        Great communities grow through people who are willing to connect, contribute, and share. We look forward to hearing from you.
      </p>
      {SITE.links.join && <a href={SITE.links.join} class="btn btn-dark btn-lg mt-10">{SITE.primaryCtaLabel}</a>}
    </div>
  </section>
</BaseLayout>
